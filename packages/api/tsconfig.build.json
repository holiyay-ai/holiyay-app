{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"rootDir": "./src",
		"outDir": "./dist",
		"sourceMap": true,
		"allowImportingTsExtensions": false,
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test"]
}
