{
	"name": "@holiyay/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./app": "./src/app.ts",
		"./types": "./src/types/index.ts"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node ./dist/index.js",
		"test": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "pnpm run build && node ./dist/src/db/migrate.js"
	},
	"dependencies": {
		"@hono/node-server": "1.19.7",
		"@hono/zod-validator": "0.5.0",
		"@supabase/supabase-js": "2.87.1",
		"bcryptjs": "^3.0.3",
		"dotenv": "17.2.3",
		"drizzle-orm": "0.45.0",
		"hono": "4.10.7",
		"openai": "6.10.0",
		"pino": "10.1.0",
		"postgres": "3.4.7",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/node": "^20.13.0",
		"drizzle-kit": "0.31.8",
		"pino-pretty": "13.1.3",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "^1.4.7"
	}
}
