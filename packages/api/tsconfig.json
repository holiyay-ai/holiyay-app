{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"baseUrl": ".",
		"rootDir": ".",
		"outDir": "./dist",
		"paths": {
			"~/*": ["./src/*"]
		},
		"types": ["node"]
	},
	"include": ["src/**/*", "test/**/*", "drizzle.config.ts"],
	"exclude": ["node_modules", "dist"]
}
