{
	"name": "holiyay",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @holiyay/api dev",
		"dev:web": "bun run --filter @holiyay/web dev",
		"dev:all": "bun run --parallel --filter '*' dev",
		"start": "bun run --filter @holiyay/api start",
		"test": "bun run --filter @holiyay/api test",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"db:generate": "bun run --filter @holiyay/api db:generate",
		"db:migrate": "bun run --filter @holiyay/api db:migrate",
		"build": "bun run --filter @holiyay/web build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8"
	}
}
