{
	"name": "holiyay",
	"packageManager": "pnpm@10.25.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "pnpm --filter @holiyay/api run dev",
		"dev:web": "pnpm --filter @holiyay/web run dev",
		"dev:all": "pnpm -w -r --parallel run dev",
		"start": "pnpm --filter @holiyay/api run start",
		"test": "pnpm --filter @holiyay/api run test",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"db:generate": "pnpm --filter @holiyay/api run db:generate",
		"db:migrate": "pnpm --filter @holiyay/api run db:migrate",
		"build": "pnpm --filter @holiyay/web run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8"
	}
}
