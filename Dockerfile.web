# Holiyay Web Dockerfile
# Multi-stage build for Next.js frontend using Bun
# Adapted for monorepo structure with packages/web

# ============================================
# Stage 1: Base image with Bun
# ============================================
FROM oven/bun:1-alpine AS base

WORKDIR /app

# ============================================
# Stage 2: Install dependencies
# ============================================
FROM base AS deps

# Install dependencies for native modules
RUN apk add --no-cache libc6-compat

# Copy workspace configuration
COPY package.json bun.lock ./
COPY packages/web/package.json ./packages/web/
COPY packages/api/package.json ./packages/api/

# Install dependencies with Bun
RUN bun install --frozen-lockfile

# ============================================
# Stage 3: Development stage (for dev compose)
# ============================================
FROM base AS dev

RUN apk add --no-cache libc6-compat

COPY package.json bun.lock ./
COPY packages/web/package.json ./packages/web/
COPY packages/api/package.json ./packages/api/

RUN bun install --frozen-lockfile

# Copy source code
COPY tsconfig.base.json ./
COPY packages/api ./packages/api
COPY packages/web ./packages/web

WORKDIR /app/packages/web

# Disable Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Start dev server
CMD ["bun", "run", "dev"]

# ============================================
# Stage 4: Build stage
# ============================================
FROM base AS builder

RUN apk add --no-cache libc6-compat

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/web/node_modules ./packages/web/node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules

# Copy source code and config
COPY tsconfig.base.json ./
COPY packages/api ./packages/api
COPY packages/web ./packages/web

WORKDIR /app/packages/web

# Disable telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Build the application
RUN bun run build

# ============================================
# Stage 5: Production runtime
# ============================================
FROM base AS runtime

WORKDIR /app

# Disable telemetry
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built assets from builder
COPY --from=builder /app/packages/web/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/packages/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/packages/web/.next/static ./.next/static

# Switch to non-root user
USER nextjs

# Expose the application port
EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Start the application with Bun
CMD ["bun", "run", "server.js"]
