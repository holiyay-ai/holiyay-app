# Holiyay Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# Database
# =============================================================================

# Local development (Docker Postgres)
DATABASE_URL=postgres://holiyay:holiyay@localhost:5432/holiyay

# Production (Supabase - use pooler URL for serverless!)
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Authentication
# =============================================================================

# Auth provider: "jwt" (local) or "supabase" (production)
AUTH_PROVIDER=jwt

# JWT Secret (required when AUTH_PROVIDER=jwt)
# Generate with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# Supabase Auth (required when AUTH_PROVIDER=supabase)
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================================
# AI Features (Optional)
# =============================================================================

# OpenAI API key for AI-powered checklists and recommendations
# OPENAI_API_KEY=sk-...

# =============================================================================
# Server
# =============================================================================

# API server port (default: 3000)
PORT=3000

# CORS allowed origins (comma-separated, or * for all)
# Production: set to your domain
CORS_ORIGINS=*

# Node environment
NODE_ENV=development

# =============================================================================
# Docker (used by docker-compose.yml)
# =============================================================================

# Database credentials for Docker Postgres
POSTGRES_USER=holiyay
POSTGRES_PASSWORD=holiyay
POSTGRES_DB=holiyay
DB_PORT=5432

# Web server port
WEB_PORT=3001
