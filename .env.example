# Holiyay Environment Configuration

# Supabase keys
SUPABASE_URL=REPLACE
SUPABASE_ANON_KEY=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=REPLACE

# OpenAI API key for AI-powered checklists and recommendations
# OPENAI_API_KEY=sk-...

# API cors origins
CORS_ORIGINS=*

# App port (default: 3000)
PORT=3000

# App environment ("prod" | "staging")
APP_ENV=staging
